# Copy this file to .env and fill in real values. NEVER commit .env
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio

# Frontend URL(s) allowed to call this API (comma separated)
CLIENT_ORIGIN=http://localhost:5173,https://adhya-mittal.vercel.app

# Optional — Nodemailer email notification on new contact messages
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
